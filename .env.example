# VoiceOps configuration. Copy to .env; every value has a working default for local use.

# --- Secrets (change for anything that is not a local demo) ---
SECRET_KEY=                      # encrypts provider keys saved from the UI. Set a long random value;
                                 # the built-in default is public and only suitable for a local demo
POSTGRES_PASSWORD=postgres
VOICEOPS_OWNER_PASSWORD=voiceops_owner
VOICEOPS_APP_PASSWORD=voiceops_app

# --- Accounts ---
SEED_DEMO=true                   # create the two demo organisations, their people, customers and policies
DEMO_CUSTOMERS=200               # customers per demo organisation, generated at first start
COOKIE_SECURE=false              # true behind HTTPS
ALLOW_SIGNUP=true                # false to stop new organisations signing up
CORS_ORIGINS=http://localhost:3400

# --- LLM (see docs/PROVIDERS.md for every provider) ---
LLM_PROVIDER=stub                # openai_compat | anthropic | ollama | stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_PRICE_INPUT_PER_MTOK=3.0     # USD per million tokens, used for cost estimates and budgets
LLM_PRICE_OUTPUT_PER_MTOK=15.0
ALLOW_PRIVATE_LLM_URLS=true      # false on a shared deployment (blocks base URLs on private networks)

# --- Calls and the agent ---
CALL_MAX_MODEL_CALLS=80          # model calls per call, all turns together
TURN_MAX_STEPS=6                 # model calls within one customer turn
CALL_MAX_TOKENS=200000
CALL_MAX_COST_USD=0.50
ORG_DAILY_COST_USD=20.00
GLOBAL_DAILY_COST_USD=200.00     # all organisations together
ORG_MAX_LIVE_CALLS=20
CALLS_PER_MINUTE=10              # new calls per signed-in person
SESSION_HOURS=12
DB_POOL_SIZE=10                  # connections per API process (through PgBouncer)
LLM_MAX_CONCURRENCY=16           # model calls in flight per API process
CUSTOMER_CREDIT_30D=25.00        # credit the agent may apply to one customer in 30 days without a supervisor
CALL_MAX_TURNS=200
CALL_MAX_MINUTES=20              # a call's time budget; once spent the agent says so and passes the call to a person
CALL_IDLE_MINUTES=30             # a live call idle this long is ended when the organisation's next call starts
CREDIT_LIMIT=10.00               # a credit up to this is applied by the agent; above it a supervisor decides

# --- Speech (see docs/PROVIDERS.md) ---
VAD_SILENCE_MS=600               # silence that ends the caller's turn
STT_PROVIDER=local               # local (faster-whisper in the API container) | openai_compat
STT_MODEL=base.en                # local: tiny.en | base.en | small.en ; hosted: e.g. whisper-large-v3
STT_DEVICE=cpu                   # cuda with docker-compose.gpu.yml
STT_COMPUTE_TYPE=int8            # int8 on CPU; float16 on the GPU
STT_BASE_URL=
STT_API_KEY=
TTS_PROVIDER=local               # local (Piper) | openai_compat
TTS_VOICE=en_US-lessac-medium
TTS_MODEL=                       # hosted only, e.g. tts-1
TTS_BASE_URL=
TTS_API_KEY=

# --- Monitoring ---
WEB_BIND=127.0.0.1               # interface the site is published on; plain HTTP, so put TLS in front before widening it
LOG_LEVEL=INFO
METRICS_TOKEN=                   # when set, /metrics requires "Authorization: Bearer <token>"
OTEL_EXPORTER_OTLP_ENDPOINT=     # set to export traces, e.g. AgentOps at http://host.docker.internal:3200, or a collector on :4318
OTEL_EXPORTER_OTLP_HEADERS=      # e.g. Authorization=Bearer%20ak_... (an AgentOps ingestion key); keep it out of the repository
